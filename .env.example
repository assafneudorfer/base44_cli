# Base44 Configuration
# Copy this file to .env and fill in your values

# Base44 server URL (default: https://app.base44.com)
BASE44_SERVER_URL=https://app.base44.com

# Your Base44 application ID (required)
BASE44_APP_ID=your-app-id-here

# User API key (get from login or Base44 dashboard)
# This is your api_key, not a bearer token
BASE44_USER_TOKEN=your-api-key-here

# Service role API key for admin operations (optional)
# Required for: logs, connectors, service role entity operations
BASE44_SERVICE_TOKEN=your-service-api-key-here

# Default output format (json, table, yaml, csv)
BASE44_OUTPUT_FORMAT=json

# HTTP request timeout in seconds
BASE44_TIMEOUT=30

# Maximum number of retries for failed requests
BASE44_MAX_RETRIES=3
